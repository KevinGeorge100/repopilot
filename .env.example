# LLM provider: gemini (free tier) | groq | openrouter | anthropic
REPOPILOT_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=   (also set REPOPILOT_MODEL)
# ANTHROPIC_API_KEY=
# REPOPILOT_MODEL=
# Comma-separated list of allowed browser origins for the API
REPOPILOT_CORS=http://localhost:3000
# Where cloned repos and indexes are stored
REPOPILOT_WORKDIR=.repopilot

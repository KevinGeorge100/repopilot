# LLM provider: gemini (free tier) | groq | openrouter | anthropic
REPOPILOT_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=   (also set REPOPILOT_MODEL)
# ANTHROPIC_API_KEY=
# REPOPILOT_MODEL=
# Comma-separated list of allowed browser origins for the API
REPOPILOT_CORS=http://localhost:3000
# Where cloned repos and indexes are stored
REPOPILOT_WORKDIR=.repopilot

# --- Hosted demo (see DEPLOY.md) ---
# 1: serve only the pre-indexed repos and refuse to index new ones (right for a 512 MB host)
# REPOPILOT_DEMO_MODE=1
# Folder holding manifest.json and answers.json
# REPOPILOT_DEMO_DIR=demo
# Serve the exported web UI from this folder, from the same origin as the API
# REPOPILOT_STATIC_DIR=web/out
# Live (uncached) questions allowed per UTC day, across all visitors
# REPOPILOT_DAILY_ASK_CAP=150
# Largest repo a visitor may index when demo mode is off (chunks)
# REPOPILOT_MAX_CHUNKS=2500
# Raises GitHub's rate limit for PR review (60 requests/hour per IP without it)
# GITHUB_TOKEN=
